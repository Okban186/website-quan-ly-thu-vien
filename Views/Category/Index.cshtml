@model WebsiteQuanLyThuVien.DTOs.PagedResult<CategoryListItem>

@{
   
    ViewData["Title"] = "Thể loại";

    var keyword = Context.Request.Query["keyword"].ToString();
    var sortBy = Context.Request.Query["sortBy"].ToString();
    var pageSize = Model.PageSize;
}

@section Scripts {
    <script src="~/js/public/category.js"
            asp-append-version="true"></script>
}
<div class="min-h-screen bg-slate-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

        <!-- Breadcrumb -->
        <div class="flex items-center gap-1.5 text-xs text-slate-500">
            <a asp-controller="Home" asp-action="Index" class="hover:text-slate-800 transition-colors">
                Trang chủ
            </a>

            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>

            <span class="text-slate-800 font-medium">
                Thể loại sách
            </span>
        </div>

        <!-- Header and Controls Row -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto overflow-hidden">

    <!-- Search -->
    <form asp-controller="Category" asp-action="Index" method="get" id="category-search-form"
          class="relative flex-1 sm:w-64 md:w-72">

        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
            <i class="fa-solid fa-magnifying-glass text-xs"></i>
        </span>

        <!-- SỬA: Thay text-sm thành text-base sm:text-sm -->
        <input type="text" id="search-input" name="keyword" value="@keyword"
               placeholder="Tìm kiếm thể loại..."
               class="w-full pl-9 pr-8 py-2 text-base sm:text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#1e3a5f]/20 focus:border-[#1e3a5f] transition-all" />

        @if (!string.IsNullOrWhiteSpace(keyword))
        {
            <button type="button" id="btn-clear-search"
                    class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-slate-400 hover:text-slate-600 transition-colors"
                    aria-label="Xóa tìm kiếm">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        }
    </form>

    <!-- Sort -->
    <div class="flex items-center gap-2 bg-white px-3 py-2 border border-slate-200 rounded-xl w-full sm:w-auto">

        <label for="sortBy" class="text-xs text-slate-500 whitespace-nowrap font-medium shrink-0">
            Sắp xếp:
        </label>

        <select id="sortBy" name="sortBy"
                class="flex-1 min-w-0 truncate text-base sm:text-xs text-slate-800 font-semibold focus:outline-none bg-transparent cursor-pointer border-none">

                    <option value="default" selected="@(string.IsNullOrEmpty(sortBy) || sortBy == "default")">
                        Mặc định
                    </option>

                    <option value="bookCount-desc" selected="@(sortBy == "bookCount-desc")">
                        Số lượng sách (Nhiều → Ít)
                    </option>

                    <option value="bookCount-asc" selected="@(sortBy == "bookCount-asc")">
                        Số lượng sách (Ít → Nhiều)
                    </option>

                    <option value="name-asc" selected="@(sortBy == "name-asc")">
                        Tên thể loại (A → Z)
                    </option>

                    <option value="name-desc" selected="@(sortBy == "name-desc")">
                        Tên thể loại (Z → A)
                    </option>
                </select>
            </div>

            <!-- Page Size -->
            <div class="flex items-center gap-2 bg-white px-3 py-2 border border-slate-200 rounded-xl w-full sm:w-auto">
         
                <label for="itemsPerPage" class="text-xs text-slate-500 whitespace-nowrap font-medium shrink-0">
                    Hiển thị:
                </label>

         
                <select id="itemsPerPage" name="pageSize"
                        class="flex-1 min-w-0 text-base sm:text-xs text-slate-800 font-semibold focus:outline-none bg-transparent cursor-pointer border-none">

                    <option value="10" selected="@(Model.PageSize == 10)"> 10 </option>
                    <option value="12" selected="@(Model.PageSize == 12)"> 12 </option> 
                    <option value="16" selected="@(Model.PageSize == 16)"> 16 </option>
                </select>
            </div>
        </div>

        <!-- Results count -->
        <div class="flex items-center justify-between text-xs text-slate-500 py-1 border-b border-slate-100">

            <div class="flex items-center gap-1.5">
                <span>Thể loại sách</span>

                <span aria-hidden="true" class="text-slate-300">
                    ·
                </span>

                <span class="font-mono tabular-nums">
                    Tổng số @Model.TotalItems thể loại
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <span class="text-[#1e3a5f] font-medium font-mono tabular-nums">
                    Tìm thấy @Model.TotalItems kết quả
                </span>
            }
        </div>

        <!-- Categories -->
        @if (Model.Items.Count > 0)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 pt-2">

                @foreach (var category in Model.Items)
                {
                    <a asp-controller="Book" asp-action="Index" asp-route-categoryId="@category.Id"
                       class="category-card bg-white rounded-2xl border border-slate-200 p-5 hover:shadow-lg hover:border-slate-300 transition-all cursor-pointer group flex flex-col justify-between space-y-4 shadow-xs">

                        <div class="flex items-start gap-3.5">

                         

                            <div class="space-y-0.5 min-w-0">

                                <h3 class="text-sm font-bold text-slate-900 group-hover:text-[#1e3a5f] transition-colors line-clamp-2 break-words"
                                    title="@category.Name">
                                    @category.Name
                                </h3>

                                <p class="text-xs text-slate-400 font-medium font-mono tabular-nums">
                                    @category.BookCount.ToString("N0") cuốn sách
                                </p>

                            </div>
                        </div>

                        <div
                            class="flex items-center justify-between text-xs font-semibold text-[#1e3a5f] pt-3 border-t border-slate-100 group-hover:underline">

                            <span>
                                Khám phá ngay
                            </span>

                            <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>

                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div
                class="flex flex-col items-center justify-center py-16 px-4 bg-white rounded-2xl border border-slate-200 text-center space-y-4">

                <div class="p-3 bg-slate-50 rounded-full text-slate-400">
                    <i class="fa-solid fa-magnifying-glass text-2xl"></i>
                </div>

                <div class="space-y-1">

                    <h3 class="text-sm font-bold text-slate-800">
                        Không tìm thấy thể loại phù hợp
                    </h3>

                    <p class="text-xs text-slate-400 max-w-sm">
                        @if (!string.IsNullOrWhiteSpace(keyword))
                        {
                            <span>
                                Không có kết quả nào trùng khớp với từ khóa
                                "<strong>@keyword</strong>".
                                Vui lòng thử tìm kiếm bằng từ khóa khác.
                            </span>
                        }
                        else
                        {
                            <span>
                                Hiện chưa có thể loại sách nào.
                            </span>
                        }
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(keyword))
                {
                    <a asp-controller="Category" asp-action="Index"
                       class="px-4 py-2 text-xs font-semibold text-white bg-[#1e3a5f] rounded-lg hover:bg-[#152943] transition-colors">
                        Xóa bộ lọc tìm kiếm
                    </a>
                }
            </div>
        }

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-200">

                <p class="text-xs text-slate-500 font-mono tabular-nums">

                    @{
                        var startItem = ((Model.Page - 1) * Model.PageSize) + 1;
                        var endItem = Math.Min(
                            Model.Page * Model.PageSize,
                            Model.TotalItems);
                    }

                    Đang hiển thị

                    <span class="font-semibold text-slate-700">
                        @startItem
                    </span>

                    đến

                    <span class="font-semibold text-slate-700">
                        @endItem
                    </span>

                    trong tổng số

                    <span class="font-semibold text-slate-700">
                        @Model.TotalItems
                    </span>

                    thể loại
                </p>

                <div class="flex items-center gap-1.5">

                    <!-- Previous -->
                    @if (Model.Page > 1)
                    {
                        <a asp-controller="Category" asp-action="Index" asp-route-keyword="@keyword" asp-route-sortBy="@sortBy"
                           asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                           class="p-2 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors"
                           aria-label="Trang trước">

                            <i class="fa-solid fa-chevron-left text-xs"></i>
                        </a>
                    }
                    else
                    {
                        <span class="p-2 border border-slate-200 rounded-xl text-slate-300 cursor-not-allowed"
                              aria-hidden="true">

                            <i class="fa-solid fa-chevron-left text-xs"></i>
                        </span>
                    }

                    <!-- Page numbers -->
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.Page)
                        {
                            <span
                                class="min-w-[2.25rem] h-9 px-2 flex items-center justify-center text-xs rounded-xl border bg-[#1e3a5f] text-white border-[#1e3a5f] font-bold shadow-xs" data-current="true" data-page="@i">
                                @i
                            </span>
                        }
                        else
                        {
                            <a asp-controller="Category" asp-action="Index" asp-route-keyword="@keyword" asp-route-page="@i" asp-route-sortBy="@sortBy"
                               asp-route-pageSize="@Model.PageSize" data-page="@i"
                               class="min-w-[2.25rem] h-9 px-2 flex items-center justify-center text-xs rounded-xl border bg-white text-slate-600 border-slate-200 hover:bg-slate-50 hover:text-slate-900 transition-all">

                                @i
                            </a>
                        }
                    }

                    <!-- Next -->
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-controller="Category" asp-action="Index" asp-route-keyword="@keyword" asp-route-sortBy="@sortBy"
                           asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                           class="p-2 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors"
                           aria-label="Trang sau">

                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </a>
                    }
                    else
                    {
                        <span class="p-2 border border-slate-200 rounded-xl text-slate-300 cursor-not-allowed"
                              aria-hidden="true">

                            <i class="fa-solid fa-chevron-right text-xs"></i>
                        </span>
                    }

                </div>
            </div>
        }

    </div>
</div>

