@using WebsiteQuanLyThuVien.Models
@using WebsiteQuanLyThuVien.ViewModels
@model WebsiteQuanLyThuVien.ViewModels.HomeViewModel;
@{
    ViewData["Title"] = "Trang chủ - Thư Viện Thành Phố";
    bool isLoggedIn = User.Identity?.IsAuthenticated == true ? true : false;
}


<!-- Thẻ bao ngoài sạch: KHÔNG dùng -mx-*, KHÔNG dùng -my-* -->
<div class="bg-slate-50 w-full">

    <!-- Hero Section: Tràn viền 100% chiều rộng của main -->
    <section class="relative overflow-hidden bg-[#183153] text-white py-12 sm:py-20 lg:py-24 w-full">
        <!-- Circle Backgrounds (Điều chỉnh responsive để không bị tràn màn hình) -->
        <div
            class="absolute -left-20 sm:-left-32 -top-20 sm:-top-32 w-64 sm:w-96 h-64 sm:h-96 rounded-full border border-white/10 pointer-events-none">
        </div>
        <div
            class="absolute -right-20 top-1/2 -translate-y-1/2 w-72 sm:w-[500px] h-72 sm:h-[500px] rounded-full border border-white/10 pointer-events-none">
        </div>

        <div class="relative max-w-4xl mx-auto px-4 text-center z-10 w-full">
            @* <div
                class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 text-white/90 text-xs font-medium mb-6 border border-white/15 backdrop-blur-xs">
                <span>Hơn 50,000 đầu sách đang chờ bạn</span>
            </div> *@

            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6 leading-tight">
                Khám Phá Tri Thức Tại Thư Viện Thành Phố
            </h1>
            <p class="text-xs sm:text-base text-slate-300 max-w-2xl mx-auto mb-8 font-normal leading-relaxed">
                Tra cứu hàng ngàn đầu sách, tài liệu nghiên cứu và đặt mượn trực tuyến nhanh chóng, tiện lợi mọi lúc mọi
                nơi.
            </p>

            <!-- Quick Search Form -->
            <form id="homepage-search-form" class="max-w-2xl mx-auto w-full">
                <div class="relative flex items-center shadow-2xl rounded-xl overflow-hidden bg-white w-full">
                    <div class="pl-3.5 sm:pl-4 text-slate-400 flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <!-- min-w-0 giúp input không bị nén phình khung ra ngoài -->
                    <input id="homepage-search-input" type="text" placeholder="Tìm theo tên sách, tác giả, NXB..."
                           class="w-full min-w-0 py-3.5 sm:py-4 pl-2.5 sm:pl-3 pr-3 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none" />
                    <button type="submit"
                            class="bg-[#1e3a5f] hover:bg-[#142944] text-white px-4 sm:px-6 py-3.5 sm:py-4 text-xs sm:text-sm font-semibold transition-colors duration-150 cursor-pointer flex-shrink-0 whitespace-nowrap">
                        Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- Main Content Area: Căn giữa nội dung bên dưới Banner -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    
        <!-- Categories Section -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-slate-900 tracking-tight">Danh mục sách</h2>
                <a asp-action="Index" asp-controller="Category"
                   class="text-xs font-semibold text-[#1e3a5f] hover:underline inline-flex items-center gap-1">
                    Xem tất cả thể loại &rarr;
                </a>
            </div>

            <div id="categories-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-8 gap-3">
                @{
                    foreach (CategoryViewModel viewModel in Model.Categories)
                    {
                        <a href="/Catalog?category=${encodeURIComponent(cat.name)}"
                           class="bg-white rounded-xl border border-slate-200 p-4 text-center hover:border-[#1e3a5f] hover:shadow-md transition-all group flex flex-col items-center justify-center cursor-pointer">
                           
                            <div class="text-xs font-semibold text-slate-800 group-hover:text-[#1e3a5f] break-words">
                                @viewModel.Name
                            </div>
                            <span class="text-[10px] text-slate-400 mt-0.5 block">0</span>
                        </a>
                    }
                }
               
            </div>
        </section>

        <!-- Featured Books -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-slate-900 tracking-tight">Sách nổi bật & Mượn nhiều</h2>
                <a href="/Catalog"
                   class="text-xs font-semibold text-[#1e3a5f] hover:underline inline-flex items-center gap-1">
                    Xem thêm &rarr;
                </a>
            </div>

            <div id="featured-books-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Render động từ JS -->
            </div>
        </section>

        <!-- Newest Books -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-slate-900 tracking-tight">Sách mới nhất</h2>
                <a href="/Catalog"
                   class="text-xs font-semibold text-[#1e3a5f] hover:underline inline-flex items-center gap-1">
                    Xem tất cả &rarr;
                </a>
            </div>

            <div id="new-books-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Render động từ JS -->
            </div>
        </section>

        <!-- Library Info & Borrow Guide -->
        <section class="grid @(isLoggedIn ? "grid-cols-1" : "grid-cols-1 lg:grid-cols-2") gap-8">
      
            <!-- Card 1: Thông báo thư viện -->
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between gap-2 mb-6">
                        <div class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-[#1e3a5f]" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                            </svg>
                            <h3 class="text-base font-bold text-slate-900">Thông báo thư viện</h3>
                        </div>

                        <div id="notif-pagination" class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-lg"></div>
                    </div>

                    <div id="notifs-container" class="space-y-4 divide-y divide-slate-100"></div>
                </div>

                <div class="pt-6 mt-4 border-t border-slate-100 flex items-center justify-between">
                    <span id="notif-page-info" class="text-xs text-slate-400">Trang 1 / 1</span>
                    <a asp-controller="Notification" asp-action="Index"
                       class="text-xs font-semibold text-[#1e3a5f] hover:underline inline-flex items-center gap-1 cursor-pointer">
                        <span>Xem tất cả thông báo</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Card 2: Hướng dẫn mượn sách -->
            @if (!isLoggedIn)
            {
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 mb-6">Hướng dẫn mượn sách</h3>

                        <div class="space-y-4">
                            <div class="flex items-start gap-3">
                                <div
                                    class="w-7 h-7 rounded-full bg-[#1e3a5f] text-white text-xs font-bold flex items-center justify-center flex-shrink-0">
                                    01</div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-800">Đăng ký thẻ thư viện</h4>
                                        <p class="text-xs text-slate-500 mt-0.5">Đăng ký thẻ thành viên miễn phí để bắt đầu mượn
                                            sách.</p>
                                        </div>
                                    </div>

                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-7 h-7 rounded-full bg-[#1e3a5f] text-white text-xs font-bold flex items-center justify-center flex-shrink-0">
                                            02</div>
                                            <div>
                                                <h4 class="text-xs font-bold text-slate-800">Tìm kiếm sách</h4>
                                                <p class="text-xs text-slate-500 mt-0.5">Tra cứu sách theo tên, tác giả, ISBN hoặc thể
                                                    loại.</p>
                                                </div>
                                            </div>

                                            <div class="flex items-start gap-3">
                                                <div
                                                    class="w-7 h-7 rounded-full bg-[#1e3a5f] text-white text-xs font-bold flex items-center justify-center flex-shrink-0">
                                                    03</div>
                                                    <div>
                                                        <h4 class="text-xs font-bold text-slate-800">Đặt mượn online</h4>
                                                        <p class="text-xs text-slate-500 mt-0.5">Đặt mượn và chọn nhận tại thư viện hoặc giao
                                                            tận nơi.</p>
                                                        </div>
                                                    </div>

                                                    <div class="flex items-start gap-3">
                                                        <div
                                                            class="w-7 h-7 rounded-full bg-[#1e3a5f] text-white text-xs font-bold flex items-center justify-center flex-shrink-0">
                                                            04</div>
                                                            <div>
                                                                <h4 class="text-xs font-bold text-slate-800">Nhận sách và trả đúng hạn</h4>
                                                                <p class="text-xs text-slate-500 mt-0.5">Nhận sách theo phương thức đã chọn và trả đúng
                                                                    hạn.</p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="mt-8 pt-4">
                                                        <a asp-controller="Account" asp-action="RegisterCard"
                                                           class="w-full bg-[#1e3a5f] hover:bg-[#142944] text-white py-2.5 rounded-lg text-xs font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer">
                                                            <span>Đăng ký thẻ thư viện</span>
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                                                <polyline points="12 5 19 12 12 19"></polyline>
                                                            </svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        </section>

                                    </div>
                                </div>