<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com" asp-append-version="true"></script>
    <script src="~/js/common/header.js" asp-append-version="true"></script>
    <script src="~/js/common/login-modal.js" asp-append-version="true"></script>
</head>

<body class="min-h-screen flex flex-col bg-slate-50">
    <partial name="_Header" />
    
    <main role="main" class="flex-grow w-full">
        @RenderBody()
    </main>

    <partial name="_Footer" />
    <partial name="_LoginModal" />


    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>
    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  
    <partial name="_ValidationScriptsPartial" />


    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/common/antiforgery.js" asp-append-version="true"></script>
    <script src="~/js/common/auth.js" asp-append-version="true"></script>
    <script src="~/js/common/modal.js" asp-append-version="true"></script>
    <script src="~/js/common/notification.js" asp-append-version="true"></script>
    
</body>

</html>
