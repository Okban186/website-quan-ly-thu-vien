@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                 ?? User.FindFirst("sub")?.Value;

    var username = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                   ?? User.FindFirst("unique_name")?.Value;

    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? User.FindFirst("email")?.Value;

    var fullName = User.FindFirst("full_name")?.Value ?? "Người dùng";

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isHome = controller == "Home" && action == "Index";
    var isCategory = controller == "Category" && action == "Index";

}

<header class="sticky top-0 z-40 w-screen max-w-full left-0 bg-white border-b border-slate-200">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">


        <div class="flex items-center justify-between h-18 py-3">

          
            <a asp-controller="Home" asp-action="Index" id="brand-logo"
               class="flex items-center gap-3 cursor-pointer group select-none">

                <div class="w-10 h-10 rounded-lg bg-[#1e3a5f]
                    flex items-center justify-center text-white
                    shadow-sm transition-transform
                    group-hover:scale-105">

                    <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">

                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z">
                        </path>

                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z">
                        </path>

                    </svg>
                </div>

                <div>
                    <span class="block text-lg font-bold text-[#1e3a5f]
                        tracking-tight leading-none">
                        Thư Viện Thành Phố
                    </span>

                    <span class="block text-[10px] font-semibold text-slate-500
                        uppercase tracking-wider mt-1">
                        CỔNG TRI THỨC THÀNH PHỐ
                    </span>
                </div>

            </a>

            <div class="flex items-center gap-3">

                @if (isAuthenticated)
                {
                    <div id="logged-in-actions" class="flex items-center gap-3">

                     
                        <div class="relative" id="notif-container">

                            <button id="btn-notifications-toggle" type="button" class="relative p-2 rounded-full
                                text-slate-600
                                hover:text-[#1e3a5f]
                                hover:bg-slate-100
                                transition-colors
                                focus:outline-none">

                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">

                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9">
                                    </path>

                                    <path d="M13.73 21a2 2 0 0 1-3.46 0">
                                    </path>

                                </svg>

                                @* <span id="notif-badge" class="absolute top-1 right-1
                                    w-2.5 h-2.5
                                    bg-rose-500 rounded-full
                                    ring-2 ring-white">
                                </span> *@

                            </button>


                            <!-- Notification Menu -->
                            <div id="notif-menu" class="hidden absolute right-0 mt-2
                                w-80 sm:w-96
                                bg-white rounded-xl shadow-xl
                                border border-slate-200
                                py-3 z-50">

                                <div class="flex items-center justify-between
                                    px-4 pb-2
                                    border-b border-slate-100 w-full">

                                    <div class="flex items-center gap-2">

                                        <span class="font-semibold
                                            text-slate-800 text-sm">
                                            Thông báo
                                        </span>

                                        <span id="notif-count-badge" class="hidden bg-rose-100
                                            text-rose-700 text-xs
                                            px-2 py-0.5
                                            rounded-full font-medium
                                            whitespace-nowrap">
                                            0 mới
                                        </span>

                                    </div>

                                    <button id="btn-mark-read" type="button" class="hidden text-xs text-blue-600
                                        hover:text-blue-800
                                        font-medium
                                        whitespace-nowrap">
                                        Đã đọc tất cả
                                    </button>

                                </div>


                                <div id="notif-wrapper" class="w-full">

                                    <div id="notif-list" class="max-h-80 overflow-y-auto
                                        divide-y divide-slate-100">
                                    </div>


                                    <!-- Empty State -->
                                    <div id="notif-empty" class="py-8 text-center
                                        text-slate-400 text-xs
                                        flex flex-col
                                        items-center justify-center
                                        gap-2 w-full">

                                        <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor"
                                             stroke-width="1.5" viewBox="0 0 24 24">

                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0">
                                            </path>

                                        </svg>

                                        <span>
                                            Không có thông báo nào
                                        </span>

                                    </div>

                                </div>


                                <!-- View All -->
                                <div class="px-4 pt-2
                                    border-t border-slate-100
                                    text-center w-full">

                                    <a asp-controller="Notification" asp-action="Index" id="btn-view-all-notifications"
                                       class="text-xs text-[#1e3a5f]
                                        hover:underline
                                        font-semibold block">

                                        Xem tất cả thông báo &rarr;

                                    </a>

                                </div>

                            </div>

                        </div>


                     
                        <div class="relative" id="user-container">

                            <button id="btn-user-menu-toggle" type="button" class="flex items-center gap-2
                                p-1.5 rounded-lg
                                hover:bg-slate-100
                                transition-colors">

                                <div class="w-8 h-8 rounded-full
                                    bg-slate-200
                                    border border-slate-300
                                    flex items-center justify-center
                                    text-slate-700
                                    font-semibold text-xs
                                    overflow-hidden">

                                    <span class="text-sm">
                                    </span>

                                </div>


                                <span id="user-name-display" class="hidden sm:inline
                                    text-xs font-semibold
                                    text-slate-700
                                    max-w-[110px] truncate">

                                    @fullName

                                </span>


                                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24">

                                    <path d="M6 9l6 6 6-6">
                                    </path>

                                </svg>

                            </button>


                            <!-- User Menu -->
                            <div id="user-menu" class="hidden absolute right-0 mt-2
                                w-56 bg-white rounded-xl
                                shadow-xl border border-slate-200
                                py-2 z-50">

                                <div class="px-4 py-2
                                    border-b border-slate-100">

                                    <p id="menu-user-name" class="text-sm font-semibold
                                        text-slate-800 truncate">
                                        @username
                                    </p>

                                    <p id="menu-user-email" class="text-xs text-slate-500 truncate">
                                        @email
                                    </p>

                                </div>


                                <!-- Account -->
                                <a id="menu-item-account" type="button" asp-area="" asp-action="Index" asp-controller="Home"
                                   class="w-full text-left
                                    px-4 py-2.5
                                    text-xs text-slate-700
                                    hover:bg-slate-50
                                    flex items-center gap-2.5
                                    transition-colors cursor-pointer">

                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round"
                                         class="lucide lucide-external-link w-3.5 h-3.5 text-slate-500" aria-hidden="true">
                                        <path d="M15 3h6v6"></path>
                                        <path d="M10 14 21 3"></path>
                                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                    </svg>

                                    <span>Quay về trang người dùng</span>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</header>

