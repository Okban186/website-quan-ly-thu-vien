<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex flex-col bg-slate-50">

    <partial name="~/Views/Shared/Staff/_StaffHeader.cshtml" />

    <main role="main" class="flex-grow flex w-full">
        
        
        <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between p-4 shrink-0">
            
            
            <div class="flex flex-col gap-6 flex-grow">
                @RenderSection("SidebarMenu", required: false)
            </div>

            
            <div class="flex flex-col gap-2 pt-4 border-t border-slate-100">
    
                <!-- CHUYỂN NÚT ĐĂNG XUẤT THÀNH FORM POST ĐỂ ĐÍNH KÈM ANTIFORGERY TOKEN -->
                <div class="w-full">
                    <!-- Sinh mã token ẩn ở một chỗ an toàn trong form để hàm getAntiForgeryToken() bốc được dữ liệu -->
                    @Html.AntiForgeryToken()

                    <!-- ✨ ĐỔI button từ type="submit" thành type="button" để Form không tự động nộp -->
                    <button type="button" id="menu-item-logout"
                            class="w-full text-center px-4 py-2.5 text-xs font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-xl flex items-center justify-center gap-2 transition-colors cursor-pointer focus:outline-none">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </button>
                </div>


            </div>

        </aside>

        
        <div class="flex-grow p-6">
            @RenderBody()
        </div>

    </main>

    <!-- Third-party libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <!-- Core -->
    <script src="~/js/core/api.js" asp-append-version="true"></script>
    <script src="~/js/core/http.js" asp-append-version="true"></script>
    <script src="~/js/core/api-client.js" asp-append-version="true"></script>

    <!--Account -->
    <script src="~/js/account/account.js" asp-append-version="true"></script>

    <!-- Common -->
    <script src="~/js/common/antiforgery.js" asp-append-version="true"></script>
    <script src="~/js/common/notification.js" asp-append-version="true"></script>
    <script src="~/js/common/header.js" asp-append-version="true"></script>

    <!-- Page-specific -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>