@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                 ?? User.FindFirst("sub")?.Value;

    var username = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                   ?? User.FindFirst("unique_name")?.Value;

    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                ?? User.FindFirst("email")?.Value;

    var fullName = User.FindFirst("full_name")?.Value ?? "Người dùng";

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isHome = controller == "Home" && action == "Index";
    var isCategory = controller == "Category" && action == "Index";

}

<header class="sticky top-0 z-40 bg-white border-b border-slate-200">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">


        <div class="flex items-center justify-between h-18 py-3">

          
            <a asp-controller="Home" asp-action="Index" id="brand-logo"
               class="flex items-center gap-3 cursor-pointer group select-none">

                <div class="w-10 h-10 rounded-lg bg-[#1e3a5f]
                    flex items-center justify-center text-white
                    shadow-sm transition-transform
                    group-hover:scale-105">

                    <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">

                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z">
                        </path>

                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z">
                        </path>

                    </svg>
                </div>

                <div>
                    <span class="block text-lg font-bold text-[#1e3a5f]
                        tracking-tight leading-none">
                        Thư Viện Thành Phố
                    </span>

                    <span class="block text-[10px] font-semibold text-slate-500
                        uppercase tracking-wider mt-1">
                        CỔNG TRI THỨC THÀNH PHỐ
                    </span>
                </div>

            </a>


            <nav class="hidden md:flex items-center
                space-x-1 lg:space-x-2
                text-sm font-medium text-slate-700">

                <a asp-controller="Home" asp-action="Index" id="nav-home"
                   class="px-3.5 py-2 rounded-md transition-colors @(isHome ? "bg-slate-100 text-[#1e3a5f] font-semibold" : "hover:text-[#1e3a5f] hover:bg-slate-50")">
                    Trang chủ
                </a>
                <a asp-controller="Resource" asp-action="Search" id="nav-catalog"
                   class="px-3.5 py-2 rounded-md transition-colors @(controller == "Book" ? "bg-slate-100 text-[#1e3a5f] font-semibold" : "hover:text-[#1e3a5f] hover:bg-slate-50")">
                    Tra cứu
                </a>
                <a asp-controller="Category" asp-action="Index" id="nav-categories"
                   class="px-3.5 py-2 rounded-md transition-colors @(isCategory ? "bg-slate-100 text-[#1e3a5f] font-semibold" : "hover:text-[#1e3a5f] hover:bg-slate-50")">
                    Thể loại
                </a>

            </nav>


            <div class="flex items-center gap-3">

                @if (isAuthenticated)
                {
                    <div id="logged-in-actions" class="flex items-center gap-3">

                     
                        <div class="relative" id="notif-container">

                            <button id="btn-notifications-toggle" type="button" class="relative p-2 rounded-full
                                text-slate-600
                                hover:text-[#1e3a5f]
                                hover:bg-slate-100
                                transition-colors
                                focus:outline-none">

                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">

                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9">
                                    </path>

                                    <path d="M13.73 21a2 2 0 0 1-3.46 0">
                                    </path>

                                </svg>

                                @* <span id="notif-badge" class="absolute top-1 right-1
                                    w-2.5 h-2.5
                                    bg-rose-500 rounded-full
                                    ring-2 ring-white">
                                </span> *@

                            </button>


                            <!-- Notification Menu -->
                            <div id="notif-menu" class="hidden absolute right-0 mt-2
                                w-80 sm:w-96
                                bg-white rounded-xl shadow-xl
                                border border-slate-200
                                py-3 z-50">

                                <div class="flex items-center justify-between
                                    px-4 pb-2
                                    border-b border-slate-100 w-full">

                                    <div class="flex items-center gap-2">

                                        <span class="font-semibold
                                            text-slate-800 text-sm">
                                            Thông báo
                                        </span>

                                        <span id="notif-count-badge" class="hidden bg-rose-100
                                            text-rose-700 text-xs
                                            px-2 py-0.5
                                            rounded-full font-medium
                                            whitespace-nowrap">
                                            0 mới
                                        </span>

                                    </div>

                                    <button id="btn-mark-read" type="button" class="hidden text-xs text-blue-600
                                        hover:text-blue-800
                                        font-medium
                                        whitespace-nowrap">
                                        Đã đọc tất cả
                                    </button>

                                </div>


                                <div id="notif-wrapper" class="w-full">

                                    <div id="notif-list" class="max-h-80 overflow-y-auto
                                        divide-y divide-slate-100">
                                    </div>


                                    <!-- Empty State -->
                                    <div id="notif-empty" class="py-8 text-center
                                        text-slate-400 text-xs
                                        flex flex-col
                                        items-center justify-center
                                        gap-2 w-full">

                                        <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor"
                                             stroke-width="1.5" viewBox="0 0 24 24">

                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0">
                                            </path>

                                        </svg>

                                        <span>
                                            Không có thông báo nào
                                        </span>

                                    </div>

                                </div>


                                <!-- View All -->
                                <div class="px-4 pt-2
                                    border-t border-slate-100
                                    text-center w-full">

                                    <a asp-controller="Notification" asp-action="Index" id="btn-view-all-notifications"
                                       class="text-xs text-[#1e3a5f]
                                        hover:underline
                                        font-semibold block">

                                        Xem tất cả thông báo &rarr;

                                    </a>

                                </div>

                            </div>

                        </div>


                     
                        <div class="relative" id="user-container">

                            <button id="btn-user-menu-toggle" type="button" class="flex items-center gap-2
                                p-1.5 rounded-lg
                                hover:bg-slate-100
                                transition-colors">

                                <div class="w-8 h-8 rounded-full
                                    bg-slate-200
                                    border border-slate-300
                                    flex items-center justify-center
                                    text-slate-700
                                    font-semibold text-xs
                                    overflow-hidden">

                                    <span class="text-sm">
                                    </span>

                                </div>


                                <span id="user-name-display" class="hidden sm:inline
                                    text-xs font-semibold
                                    text-slate-700
                                    max-w-[110px] truncate">

                                    @fullName

                                </span>


                                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2"
                                     viewBox="0 0 24 24">

                                    <path d="M6 9l6 6 6-6">
                                    </path>

                                </svg>

                            </button>


                            <!-- User Menu -->
                            <div id="user-menu" class="hidden absolute right-0 mt-2
                                w-56 bg-white rounded-xl
                                shadow-xl border border-slate-200
                                py-2 z-50">

                                <div class="px-4 py-2
                                    border-b border-slate-100">

                                    <p id="menu-user-name" class="text-sm font-semibold
                                        text-slate-800 truncate">
                                        @username
                                    </p>

                                    <p id="menu-user-email" class="text-xs text-slate-500 truncate">
                                        @email
                                    </p>

                                </div>


                                <!-- Account -->
                                <button id="menu-item-account" type="button" class="w-full text-left
                                    px-4 py-2.5
                                    text-xs text-slate-700
                                    hover:bg-slate-50
                                    flex items-center gap-2.5
                                    transition-colors">

                                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2"
                                         viewBox="0 0 24 24">

                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2">
                                        </path>

                                        <circle cx="12" cy="7" r="4">
                                        </circle>

                                    </svg>

                                    <span>Tài khoản</span>

                                </button>


                                <!-- Borrow -->
                                <button id="menu-item-borrow" type="button" class="w-full text-left
                                    px-4 py-2.5
                                    text-xs text-slate-700
                                    hover:bg-slate-50
                                    flex items-center gap-2.5
                                    transition-colors">

                                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2"
                                         viewBox="0 0 24 24">

                                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z">
                                        </path>

                                    </svg>

                                    <span>Đang mượn</span>

                                </button>


                                <!-- Fines -->
                                <button id="menu-item-fines" type="button" class="w-full text-left
                                    px-4 py-2.5
                                    text-xs text-slate-700
                                    hover:bg-slate-50
                                    flex items-center gap-2.5
                                    transition-colors">

                                    <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" stroke-width="2"
                                         viewBox="0 0 24 24">

                                        <circle cx="12" cy="12" r="10">
                                        </circle>

                                        <line x1="12" y1="8" x2="12" y2="12">
                                        </line>

                                        <line x1="12" y1="16" x2="12.01" y2="16">
                                        </line>

                                    </svg>

                                    <span>Phí phạt</span>

                                </button>


                                <div class="border-t border-slate-100 my-1">
                                </div>


                                <!-- Logout -->
                                <button id="menu-item-logout" type="button" class="w-full text-left
                                    px-4 py-2.5
                                    text-xs text-rose-600
                                    hover:bg-rose-50
                                    flex items-center gap-2.5
                                    transition-colors">

                                    <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2"
                                         viewBox="0 0 24 24">

                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4">
                                        </path>

                                        <polyline points="16 17 21 12 16 7">
                                        </polyline>

                                        <line x1="21" y1="12" x2="9" y2="12">
                                        </line>

                                    </svg>

                                    <span>Đăng xuất</span>

                                </button>

                            </div>

                        </div>

                    </div>
                }
                else
                {
            
                    <div id="logged-out-actions" class="flex items-center gap-2">

                        <button id="btn-login-open" type="button" onclick="openLoginModal()" class="px-3.5 py-1.5 text-xs
                            font-semibold text-[#1e3a5f]
                            border border-[#1e3a5f]
                            rounded-lg hover:bg-blue-50
                            transition-colors">

                            Đăng nhập

                        </button>


                        <a asp-controller="Account" asp-action="RegisterCard" id="btn-register-card-open" class="px-3.5 py-1.5 text-xs
                            font-semibold text-white
                            bg-[#1e3a5f]
                            hover:bg-[#172e4c]
                            rounded-lg shadow-sm
                            transition-colors inline-block">

                            Đăng ký thẻ

                        </a>

                    </div>
                }


        
                <button id="btn-mobile-menu" type="button" class="md:hidden p-2 rounded-lg
                    text-slate-600
                    hover:bg-slate-100" aria-label="Toggle menu" aria-expanded="false">

                    <!-- Menu Icon -->
                    <svg id="icon-menu" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">

                        <line x1="3" y1="12" x2="21" y2="12">
                        </line>

                        <line x1="3" y1="6" x2="21" y2="6">
                        </line>

                        <line x1="3" y1="18" x2="21" y2="18">
                        </line>

                    </svg>


                    <!-- Close Icon -->
                    <svg id="icon-close" class="hidden w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">

                        <line x1="18" y1="6" x2="6" y2="18">
                        </line>

                        <line x1="6" y1="6" x2="18" y2="18">
                        </line>

                    </svg>

                </button>

            </div>

        </div>


 
        <div id="mobile-menu" class="hidden md:hidden py-3 border-t border-slate-200">
            <!-- Public Navigation -->

            <a asp-controller="Home" asp-action="Index"
               class="nav-mobile-btn block w-full text-left px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-md @(isHome ? "bg-slate-100 text-[#1e3a5f] font-semibold" : "hover:text-[#1e3a5f] hover:bg-slate-50")">
                Trang chủ
            </a>

            <a asp-controller="Resource" asp-action="Search"
               class="nav-mobile-btn block w-full text-left px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-md @(controller == "Book" ? "bg-slate-100 text-[#1e3a5f] font-semibold" : "hover:text-[#1e3a5f] hover:bg-slate-50")"
               data-target="catalog">
                Tra cứu sách
            </a>

            <a asp-controller="Category" asp-action="Index"
               class="nav-mobile-btn block w-full text-left px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 rounded-md @(isCategory ? "bg-slate-100 text-[#1e3a5f] font-semibold" : "hover:text-[#1e3a5f] hover:bg-slate-50")"
               data-target="categories">
                Thể loại
            </a>

        </div>

    </div>

</header>

