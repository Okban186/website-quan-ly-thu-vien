<div id="login-modal"
     class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div
        class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-[#1e3a5f] text-white flex items-center justify-center">
                    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                </div>
                <span class="font-bold text-slate-800 text-sm">Đăng nhập hệ thống</span>
            </div>
            <button id="btn-close-modal" type="button"
                    class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="px-6 pb-6 pt-2 space-y-6">
       
            <!-- Login Form -->
            <form id="login-form" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" id="login-role-input" value="reader" />

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">
                        Tên đăng nhập / Số thẻ / Email
                    </label>
                    <div class="relative">
                        <input id="login-username" type="text" required value="" placeholder="s@gmail.com"
                               class="w-full text-xs text-slate-800 border border-slate-300 rounded-lg pl-9 pr-3.5 py-2.5 focus:outline-none focus:border-[#1e3a5f]" />
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">
                        Mật khẩu
                    </label>
                    <div class="relative">
                        <input id="login-password" type="password" required value="" placeholder="••••••••"
                               class="w-full text-xs text-slate-800 border border-slate-300 rounded-lg pl-9 pr-10 py-2.5 focus:outline-none focus:border-[#1e3a5f]" />
                        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
            
                        <button id="btn-toggle-password" type="button"
                                class="absolute right-3 top-3 text-slate-400 hover:text-slate-600">
                            <!-- Eye Icon -->
                            <svg id="icon-eye" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                                 viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <!-- Eye Off Icon (Hidden) -->
                            <svg id="icon-eye-off" class="w-4 h-4 hidden" fill="none" stroke="currentColor"
                                 stroke-width="2" viewBox="0 0 24 24">
                                <path
                                    d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24">
                                </path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between text-[11px]">
                    <label class="flex items-center gap-2 text-slate-600 cursor-pointer">
                        <input id="login-remember" type="checkbox" checked class="w-3.5 h-3.5 rounded text-[#1e3a5f]" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="#" class="text-[#1e3a5f] hover:underline font-semibold">
                        Quên mật khẩu?
                    </a>
                </div>

                <button type="submit"
                        class="w-full bg-[#1e3a5f] hover:bg-[#142944] text-white py-2.5 rounded-xl font-bold text-xs shadow-md transition-colors cursor-pointer mt-2">
                    Đăng nhập
                </button>
            </form>

            

            <div class="text-center text-xs text-slate-500">
                <span>Chưa có tài khoản? </span>
                <a href="/RegisterCard" class="text-[#1e3a5f] font-bold hover:underline">
                    Đăng ký thẻ thư viện
                </a>
            </div>
        </div>
    </div>
</div>