                                                                                                                                                    <i id="eye-icon-2" class="fa-solid fa-eye"></i>
                                                                                                                                                </button>
                                                                                                                                            </div>
                                                                                                                                        </div>

                                                                                                                                        <!-- Xác nhận mật khẩu mới -->
                                                                                                                                        <div>
