                                                                                                                                                       class="w-full text-xs text-slate-800 border border-slate-300 rounded-lg pl-3.5 pr-10 py-2.5 focus:outline-none focus:border-[#1e3a5f]">
                                                                                                                                                <button type="button" onclick="togglePasswordVisibility('sec-confirm-pw', 'eye-icon-3')"
                                                                                                                                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 cursor-pointer">
                                                                                                                                                    <i id="eye-icon-3" class="fa-solid fa-eye"></i>
                                                                                                                                                </button>
                                                                                                                                            </div>
                                                                                                                                        </div>

                                                                                                                                        <div class="pt-2">
                                                                                                                                            <button type="submit"
