                                                                                                                                            <label class="block font-semibold text-slate-700 mb-1">Mật khẩu mới</label>
                                                                                                                                            <div class="relative">
                                                                                                                                                <input type="password" id="sec-new-pw" placeholder="••••••••" required
                                                                                                                                                       class="w-full text-xs text-slate-800 border border-slate-300 rounded-lg pl-3.5 pr-10 py-2.5 focus:outline-none focus:border-[#1e3a5f]">
                                                                                                                                                <button type="button" onclick="togglePasswordVisibility('sec-new-pw', 'eye-icon-2')"
