@{
    ViewData["Title"] = "Quản lý Phí phạt";
}

<div class="min-h-screen bg-slate-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight mb-6 font-serif-title">
            Phí phạt
        </h1>

        <!-- Banner cảnh báo khoản chưa thanh toán -->
        <div id="unpaid-warning-banner"
             class="hidden bg-rose-50 border border-rose-200 rounded-xl p-4 sm:p-5 flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 shadow-xs">
            <div class="flex items-center gap-3">
                <div
                    class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 flex-shrink-0">
                    <i class="fa-solid fa-circle-exclamation text-lg"></i>
                </div>
                <div>
                    <p class="text-xs font-semibold text-rose-900">
                        Bạn có <span id="banner-unpaid-count">0</span> khoản phí chưa thanh toán
                    </p>
                    <p class="text-xs text-rose-700 mt-0.5">
                        Tổng tiền phạt cần nộp: <span id="banner-total-unpaid" class="font-bold text-sm">0đ</span>.
                        Vui lòng thanh toán để tiếp tục mượn sách.
                    </p>
                </div>
            </div>

            <button type="button" onclick="openPayAllLoadedUnpaid()"
                    class="bg-rose-600 hover:bg-rose-700 text-white px-5 py-2 rounded-lg text-xs font-semibold shadow-xs transition-colors cursor-pointer self-end sm:self-center">
                Thanh toán tất cả
            </button>
        </div>

        <!-- 3 Thẻ thống kê tổng quan -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs">
                <span class="text-xs font-medium text-slate-500 block">Tổng tiền phạt chưa nộp</span>
                <div class="flex items-baseline gap-2 mt-1">
                    <span id="stat-total-unpaid" class="text-2xl font-bold text-rose-600">0đ</span>
                    <span id="stat-unpaid-count" class="text-xs text-slate-400">(0 khoản)</span>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs">
                <span class="text-xs font-medium text-slate-500 block">Đã thanh toán</span>
                <div class="flex items-baseline gap-2 mt-1">
                    <span id="stat-total-paid" class="text-2xl font-bold text-emerald-600">0đ</span>
                    <span id="stat-paid-count" class="text-xs text-slate-400">(0 khoản)</span>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs">
                <span class="text-xs font-medium text-slate-500 block">Đơn giá phạt quy định</span>
                <div class="mt-1">
                    <span class="text-sm font-bold text-slate-800">5.000đ / ngày / tài liệu</span>
                    <span class="text-[11px] text-slate-400 block mt-0.5">Theo quy chế thư viện</span>
                </div>
            </div>
        </div>

        <!-- Thanh Tab lọc trạng thái (Chỉ còn UNPAID và PAID) -->
        <div class="flex items-center gap-6 border-b border-slate-200 mb-6">
            <button type="button" id="tab-unpaid" onclick="switchTab('UNPAID')"
                    class="pb-3 text-xs font-bold transition-colors border-b-2 border-[#1e3a5f] text-[#1e3a5f] flex items-center gap-1.5 cursor-pointer">
                <span>Chưa thanh toán</span>
                <span id="badge-unpaid-count"
                      class="bg-rose-100 text-rose-700 px-1.5 py-0.5 rounded-full text-[10px]">0</span>
            </button>

            <button type="button" id="tab-paid" onclick="switchTab('PAID')"
                    class="pb-3 text-xs font-bold transition-colors border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-1.5 cursor-pointer">
                <span>Đã thanh toán</span>
                <span id="badge-paid-count"
                      class="bg-emerald-100 text-emerald-700 px-1.5 py-0.5 rounded-full text-[10px]">0</span>
            </button>
        </div>

        <!-- Thanh công cụ chọn nhiều khoản chưa thanh toán -->
        <div id="batch-toolbar"
             class="hidden bg-white rounded-xl border border-slate-200 p-4 mb-4 shadow-xs flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <label class="flex items-center gap-2.5 cursor-pointer select-none">
                    <input type="checkbox" id="checkbox-select-all" onchange="handleToggleSelectAll(this.checked)"
                           class="w-4 h-4 rounded border-slate-300 text-[#1e3a5f] focus:ring-[#1e3a5f] cursor-pointer accent-[#1e3a5f]" />
                    <span class="text-xs font-bold text-slate-800 hover:text-[#1e3a5f]">Chọn tất cả</span>
                </label>

                <span class="text-slate-300">|</span>

                <span class="text-xs text-slate-600">
                    Đã chọn: <strong id="selected-count-label" class="text-slate-900 font-bold">0</strong> / <span
                    id="loaded-unpaid-count-label">0</span> khoản
                </span>
            </div>

            <div
                class="flex items-center justify-between sm:justify-end gap-4 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100">
                <div class="text-left sm:text-right">
                    <span class="text-[11px] text-slate-500 mr-1.5">Tổng thanh toán:</span>
                    <span id="selected-total-amount" class="text-base font-bold text-rose-600 tabular-nums">0đ</span>
                </div>

                <button type="button" id="btn-pay-selected" disabled onclick="openPaySelected()"
                        class="px-4 py-2 rounded-lg text-xs font-semibold shadow-xs transition-colors flex items-center gap-2 bg-slate-100 text-slate-400 border border-slate-200 cursor-not-allowed">
                    <span>Thanh toán các khoản đã chọn</span>
                    <span id="btn-pay-selected-badge"
                          class="hidden bg-white/20 text-white px-1.5 py-0.5 rounded text-[10px] font-bold tabular-nums">0</span>
                </button>
            </div>
        </div>

        <!-- Danh sách các khoản phí -->
        <div id="charges-list-container" class="space-y-4"></div>

        <!-- Trạng thái trống -->
        <div id="empty-state" class="hidden bg-white rounded-xl border border-slate-200 p-12 text-center shadow-xs">
            <div
                class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
                <i class="fa-solid fa-receipt text-xl"></i>
            </div>
            <p class="text-sm font-bold text-slate-800">Không có khoản phí nào</p>
            <p class="text-xs text-slate-500 mt-1">Bạn hiện không có giao dịch phí phạt nào trong mục này.</p>
        </div>

        <!-- Phần tử kích hoạt Infinite Scroll -->
        <div id="infinite-scroll-sentinel" class="py-6 flex flex-col items-center justify-center">
            <div id="loading-spinner" class="hidden flex items-center gap-2 text-xs font-semibold text-slate-500">
                <i class="fa-solid fa-circle-notch fa-spin text-[#1e3a5f] text-base"></i>
                <span>Đang tải thêm dữ liệu...</span>
            </div>
            <p id="end-of-list-msg" class="hidden text-[11px] text-slate-400">Đã hiển thị toàn bộ danh sách khoản phí.
            </p>
        </div>
    </div>
</div>

<!-- Modal Thanh toán VietQR -->
<div id="payment-modal"
     class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
    <div id="payment-modal-box"
         class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden transform transition-all scale-95 opacity-0 duration-150">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900">Thanh toán tiền phạt</h3>
                <p id="modal-subtitle" class="text-[11px] text-slate-500 mt-0.5"></p>
            </div>
            <button type="button" onclick="closePaymentModal()"
                    class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer"
                    title="Hủy">
                <i class="fa-solid fa-xmark text-base"></i>
            </button>
        </div>

        <div class="p-6 space-y-5">
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 space-y-3.5 text-xs">
                <div class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
                    <span class="font-semibold text-slate-600">Số tiền</span>
                    <span id="modal-pay-amount" class="text-lg font-bold text-rose-600">0 ₫</span>
                </div>

                <div id="modal-multi-items-box"
                     class="hidden bg-white rounded-lg p-2.5 border border-slate-200/80 space-y-1.5">
                    <span class="text-[11px] font-semibold text-slate-500 block">
                        Khoản thanh toán (<span id="modal-multi-count">0</span>):
                    </span>
                    <div id="modal-multi-list" class="max-h-24 overflow-y-auto space-y-1 divide-y divide-slate-100">
                    </div>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
                    <span class="font-semibold text-slate-600">Tên ngân hàng</span>
                    <span class="font-semibold text-slate-900 text-right max-w-[200px]">
                        Techcombank (Ngân hàng TMCP Kỹ Thương Việt Nam)
                    </span>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
                    <span class="font-semibold text-slate-600">Chủ tài khoản</span>
                    <span class="font-bold text-slate-900 uppercase">THƯ VIỆN THÀNH PHỐ</span>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
                    <span class="font-semibold text-slate-600">Số tài khoản chuyển</span>
                    <div class="flex items-center gap-1.5">
                        <span id="modal-bank-account"
                              class="font-mono font-bold text-slate-900 text-sm tracking-wider">123456789</span>
                        <button type="button" onclick="copyField('123456789', 'copy-acc-msg')"
                                class="p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-200/70 rounded transition-colors cursor-pointer"
                                title="Sao chép">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                        <span id="copy-acc-msg" class="hidden text-[10px] text-emerald-600 font-semibold">Đã chép</span>
                    </div>
                </div>

                <div class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
                    <span class="font-semibold text-slate-600">Nội dung chuyển khoản</span>
                    <div class="flex items-center gap-1.5">
                        <span id="modal-transfer-content"
                              class="font-mono font-bold text-[#1e3a5f] bg-blue-50/80 px-2 py-0.5 rounded border border-blue-100">PHAT
                            TV 000123</span>
                            <button type="button" onclick="copyTransferContent()"
                                    class="p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-200/70 rounded transition-colors cursor-pointer"
                                    title="Sao chép">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                            <span id="copy-content-msg" class="hidden text-[10px] text-emerald-600 font-semibold">Đã
                                chép</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-1">
                            <span class="font-semibold text-slate-600 flex items-center gap-1.5">
                                <i class="fa-regular fa-clock text-slate-400"></i>
                                <span>Thời gian còn lại</span>
                            </span>
                            <span id="modal-countdown"
                                  class="font-mono text-sm font-bold tabular-nums px-2 py-0.5 rounded text-amber-700 bg-amber-50 border border-amber-200">
                                15:00
                            </span>
                        </div>
                    </div>

                    <div id="qr-active-box" class="bg-slate-50 rounded-xl p-4 text-center border border-slate-200">
                        <div
                            class="w-36 h-36 bg-white p-2 rounded-xl border border-slate-300 mx-auto flex items-center justify-center shadow-xs">
                            <i class="fa-solid fa-qrcode text-8xl text-slate-800"></i>
                        </div>
                        <p class="text-[11px] text-slate-500 mt-2">
                            Mở ứng dụng ngân hàng và quét mã VietQR để thanh toán tự động
                        </p>
                    </div>

                    <div id="qr-expired-box"
                         class="hidden bg-rose-50 rounded-xl p-4 text-center border border-rose-200 space-y-1.5">
                        <i class="fa-solid fa-triangle-exclamation text-2xl text-rose-600"></i>
                        <p class="text-xs font-bold text-rose-900">Giao dịch đã hết thời gian thanh toán</p>
                        <p class="text-[11px] text-rose-700 leading-relaxed">
                            Thời gian hiệu lực đã kết thúc (00:00). Giao dịch không còn hiệu lực. Vui lòng hủy và thực hiện lại
                            nếu cần thanh toán.
                        </p>
                    </div>

                    <div class="pt-2">
                        <button type="button" onclick="closePaymentModal()"
                                class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-xl text-xs font-semibold transition-colors cursor-pointer text-center">
                            Hủy
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script src="~/js/public/member-charges/index.js" asp-append-version="true"></script>
        }