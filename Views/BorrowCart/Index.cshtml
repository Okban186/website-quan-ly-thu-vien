@model List<dynamic>
@{
    ViewData["Title"] = "Danh sách chờ mượn";
    var firstUser = Model.FirstOrDefault();
    var phone = firstUser != null ? firstUser.Phone : "";
    var address = firstUser != null ? firstUser.Address : "";
}

@section Scripts {
    <script src="~/js/public/reservation/borrow-queue.js" asp-append-version="true"></script>
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <!-- Header Section -->
    <div class="flex items-center justify-between border-b pb-4">
        <div>
            <p class="text-xs text-slate-500 mt-1">Kiểm tra các tài liệu trong khay trước khi gửi yêu cầu mượn</p>
        </div>
        <span id="queue-count-badge" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-100 text-slate-600">
            0 tài liệu
        </span>
    </div>
    <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </span>
        <input type="text" id="queue-search-input"
               class="w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#1e3a5f] transition-colors shadow-xs"
               placeholder="Tìm kiếm theo tên tài liệu hoặc tác giả trong khay...">
    </div>

    <!-- Container Danh Sách (Full Width) -->
    <div class="space-y-3" id="queue-items-container">
        <!-- Skeleton Ban Đầu -->
        <div id="initial-skeleton" class="space-y-3">
            @for (int i = 0; i < 3; i++)
            {
                <div class="p-4 bg-white border border-slate-200 rounded-lg animate-pulse flex gap-4">
                    <div class="w-16 h-24 bg-slate-200 rounded shrink-0"></div>
                    <div class="flex-1 space-y-2 py-1">
                        <div class="h-4 bg-slate-200 rounded w-3/4"></div>
                        <div class="h-3 bg-slate-200 rounded w-1/2"></div>
                        <div class="h-3 bg-slate-200 rounded w-1/4 mt-4"></div>
                    </div>
                </div>
            }
        </div>

        <!-- Empty State -->
        <div id="empty-state" class="hidden text-center py-12 bg-white border border-slate-200 rounded-lg p-6">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M20 13V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7m16 0v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-5m16 0h-2.586a1 1 0 0 0-.707.293l-2.414 2.414a1 1 0 0 1-.707.293h-3.172a1 1 0 0 1-.707-.293l-2.414-2.414A1 1 0 0 0 6.586 13H4" />
            </svg>
            <p class="text-xs text-slate-400 mt-1">Hãy tìm kiếm và thêm các tài liệu cần mượn vào danh sách.</p>
        </div>

        <!-- Skeleton Cuộn Đáy -->
        <div id="bottom-skeleton" class="hidden space-y-3">
            @for (int i = 0; i < 2; i++)
            {
                <div class="p-4 bg-white border border-slate-200 rounded-lg animate-pulse flex gap-4">
                    <div class="w-16 h-24 bg-slate-200 rounded shrink-0"></div>
                    <div class="flex-1 space-y-2 py-1">
                        <div class="h-4 bg-slate-200 rounded w-3/4"></div>
                        <div class="h-3 bg-slate-200 rounded w-1/2"></div>
                    </div>
                </div>
            }
        </div>

        <div id="scroll-sentinel" class="h-4 w-full"></div>
    </div>
</div>

<div id="global-floating-bar"
     class="fixed bottom-6 right-6 z-40 transition-all duration-300 transform translate-y-20 opacity-0 pointer-events-none">
    <button onclick="openBorrowModal()"
            class="bg-[#1e3a5f] hover:bg-[#142944] text-white px-5 py-3 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-2.5 cursor-pointer font-semibold text-xs border border-white/20">
        
        <span>Đặt mượn</span>
        <span id="floating-selected-count"
              class="bg-emerald-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full ml-1">0</span>
    </button>
</div>

<div id="borrow-flow-modal"
     class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6">
    <div class="bg-white rounded-2xl max-w-2xl w-full shadow-2xl border border-slate-200 overflow-hidden">
   
        <div class="flex items-center justify-end px-6 py-4 border-b border-slate-100">
          
            <button onclick="closeBorrowModal()"
                    class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="p-6 sm:p-8 space-y-6">

            <!-- Danh sách các tài liệu đã chọn hiển thị trong modal -->
            <div class="bg-slate-50 rounded-xl border border-slate-200 p-3.5 space-y-2">
                <div class="flex justify-between items-center">
                    <h3 class="text-xs font-bold text-slate-800">Tài liệu đã chọn (<span
                        id="modal-summary-count">0</span>)</h3>
                    </div>
                    <div id="modal-selected-books-list"
                         class="max-h-36 overflow-y-auto space-y-2 divide-y divide-slate-100">
                        <!-- Các item sách được render bằng JS vào đây -->
                    </div>
                </div>

                <!-- Stepper Progress Bar -->
                <div class="flex items-center justify-center gap-3">
                    <div id="step-badge-1"
                         class="w-7 h-7 rounded-full text-xs font-bold flex items-center justify-center transition-colors bg-[#1e3a5f] text-white">
                        1</div>
                        <div id="step-line-1" class="w-12 sm:w-20 h-0.5 bg-slate-200"></div>
                        <div id="step-badge-2"
                             class="w-7 h-7 rounded-full text-xs font-bold flex items-center justify-center transition-colors bg-slate-200 text-slate-500">
                            2</div>
                            <div id="step-line-2" class="w-12 sm:w-20 h-0.5 bg-slate-200"></div>
                            <div id="step-badge-3"
                                 class="w-7 h-7 rounded-full text-xs font-bold flex items-center justify-center transition-colors bg-slate-200 text-slate-500">
                                3</div>
                            </div>

                            <!-- STEP 1: CHỌN PHƯƠNG THỨC -->
                            <div id="modal-step-1" class="space-y-4">
                                <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Chọn phương thức nhận</h3>
                                <div class="space-y-3">
                                    <!-- Đổi thành RESERVATION -->
                                    <div onclick="selectModalDelivery('RESERVATION')" id="option-pickup"
                                         class="p-4 rounded-xl border border-[#1e3a5f] bg-blue-50/30 ring-1 ring-[#1e3a5f] transition-all cursor-pointer flex items-start gap-3.5">
                                        <div id="dot-pickup"
                                             class="w-4 h-4 rounded-full mt-0.5 border border-[#1e3a5f] bg-[#1e3a5f] flex items-center justify-center transition-colors">
                                            <div class="w-1.5 h-1.5 rounded-full bg-white"></div>
                                        </div>
                                        <div class="space-y-1">
                                            <h4 class="text-xs font-bold text-slate-900">Nhận tại thư viện</h4>
                                            <p class="text-xs text-slate-600">Đến trực tiếp thư viện để nhận. Có thể nhận ngay trong
                                                ngày làm việc.</p>
                                                <p class="text-[11px] text-slate-500 pt-1">Giờ mở cửa: T2-T7: 8:00 – 20:00 | CN: 8:00 –
                                                    17:00</p>
                                                </div>
                                            </div>

                                            <!-- DELIVERY -->
                                            <div onclick="selectModalDelivery('DELIVERY')" id="option-delivery"
                                                 class="p-4 rounded-xl border border-slate-200 hover:border-slate-300 transition-all cursor-pointer flex items-start gap-3.5">
                                                <div id="dot-delivery"
                                                     class="w-4 h-4 rounded-full mt-0.5 border border-slate-300 bg-white flex items-center justify-center transition-colors">
                                                    <div class="w-1.5 h-1.5 rounded-full bg-white hidden"></div>
                                                </div>
                                                <div class="space-y-1 flex-1">
                                                    <h4 class="text-xs font-bold text-slate-900">Giao tận nơi</h4>
                                                    <p class="text-xs text-slate-600">Chúng tôi sẽ giao đến địa chỉ của bạn trong 1-2 ngày làm
                                                        việc.</p>
                                                        <p class="text-[11px] text-slate-500 pt-0.5">📦 Phí giao hàng: Miễn phí trong nội thành</p>

                                                        <div id="modal-input-wrapper" class="mt-3 pt-2 hidden space-y-3">
                                                            <div>
                                                                <label class="block text-[11px] font-semibold text-slate-700 mb-1">Số điện thoại
                                                                    nhận sách:</label>
                                                                    <input type="tel" id="modal-phone-input"
                                                                           class="w-full text-xs text-slate-800 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:border-[#1e3a5f] transition-colors"
                                                                           placeholder="Nhập số điện thoại (10 chữ số)..." value="@phone">
                                                                    <!-- Thông báo lỗi SĐT -->
                                                                    <p id="phone-error-msg" class="text-[11px] text-rose-500 mt-1 hidden"></p>
                                                                </div>
                                                                <div>
                                                                    <label class="block text-[11px] font-semibold text-slate-700 mb-1">Địa chỉ giao
                                                                        nhận:</label>
                                                                        <input type="text" id="modal-address-input"
                                                                               class="w-full text-xs text-slate-800 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:border-[#1e3a5f] transition-colors"
                                                                               placeholder="Nhập số nhà, tên đường, phường/xã..." value="@address">
                                                                        <!-- Thông báo lỗi Địa chỉ -->
                                                                        <p id="address-error-msg" class="text-[11px] text-rose-500 mt-1 hidden"></p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="bg-slate-50 rounded-xl border border-slate-200 p-4">
                                                        <span class="text-xs text-slate-500 block">Thời hạn mượn</span>
                                                        <span class="text-base font-bold text-slate-900 block mt-0.5">14 ngày</span>
                                                        <span class="text-xs text-slate-500 mt-1 block">Có thể gia hạn thêm 1 lần (tối đa 7 ngày)</span>
                                                    </div>

                                                    <button onclick="goToModalStep(2)"
                                                            class="w-full bg-[#1e3a5f] hover:bg-[#142944] text-white py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 shadow-sm transition-colors cursor-pointer">
                                                        <span>Tiếp theo</span>
                                                    </button>
                                                </div>

                                                <!-- STEP 2: XÁC NHẬN -->
                                                <div id="modal-step-2" class="space-y-4 hidden">
                                                    <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Xác nhận đặt mượn</h3>
                                                    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100 text-xs shadow-xs">
                                                        <div class="p-3.5 flex justify-between">
                                                            <span class="text-slate-500">Số lượng tài liệu</span>
                                                            <span id="confirm-count" class="font-bold text-slate-900">0</span>
                                                        </div>
                                                        <div class="p-3.5 flex justify-between">
                                                            <span class="text-slate-500">Phương thức</span>
                                                            <span id="confirm-method" class="font-semibold text-slate-800">Nhận tại thư viện</span>
                                                        </div>
                                                        <div id="confirm-phone-row" class="p-3.5 flex justify-between hidden">
                                                            <span class="text-slate-500">Số điện thoại</span>
                                                            <span id="confirm-phone" class="font-semibold text-slate-800"></span>
                                                        </div>
                                                        <div id="confirm-address-row" class="p-3.5 flex justify-between hidden">
                                                            <span class="text-slate-500">Địa chỉ nhận</span>
                                                            <span id="confirm-address" class="font-semibold text-slate-800"></span>
                                                        </div>
                                                    </div>

                                                    <div class="flex items-center gap-3 pt-2">
                                                        <button onclick="goToModalStep(1)"
                                                                class="flex-1 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer">
                                                            Quay lại
                                                        </button>
                                                        <button id="btn-modal-submit" onclick="submitModalBorrow()"
                                                                class="flex-1 bg-[#1e3a5f] hover:bg-[#142944] text-white py-2.5 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 shadow-sm transition-colors cursor-pointer">
                                                            Xác nhận đặt mượn
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- STEP 3: THÀNH CÔNG -->
                                                <div id="modal-step-3" class="py-6 text-center space-y-6 hidden">
                                                    <div
                                                        class="w-16 h-16 rounded-2xl bg-emerald-100 border border-emerald-200 text-emerald-600 flex items-center justify-center mx-auto text-2xl font-bold">
                                                        ✓</div>
                                                        <div class="space-y-2">
                                                            <h3 class="text-2xl font-bold text-slate-900">Đặt mượn thành công!</h3>
                                                          
                                                        </div>
    
                                                        <div class="bg-slate-50 rounded-xl border border-slate-200 p-4 max-w-xs mx-auto space-y-3">
                                                            <!-- 1. Mã yêu cầu nội bộ (Luôn hiển thị cho mọi loại) -->
                                                            <div>
                                                                <span class="text-[11px] text-slate-400 font-medium block">Mã yêu cầu</span>
                                                                <span id="modal-request-code"
                                                                      class="text-base font-bold font-mono text-slate-900 block">-</span>
                                                            </div>

                                                         

                                                            <div class="flex items-center justify-center gap-1.5 text-xs font-semibold text-amber-600 pt-1">
                                                                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                                                <span>Chờ xử lý</span>
                                                            </div>
                                                        </div>

                                                     
                                                    </div>

                                                </div>
                                            </div>
                                        </div>